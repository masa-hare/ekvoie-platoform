# Required — MySQL connection string provided by Railway MySQL plugin
DATABASE_URL=mysql://user:password@host:3306/dbname

# Required — Random secret for signing session JWTs (generate with: openssl rand -base64 32)
JWT_SECRET=your-random-secret-here

# Required — scrypt hash for the /admin panel password. ADMIN_PASSWORD is only
# accepted temporarily during migration and should not be used for production.
ADMIN_PASSWORD_HASH=scrypt$v1$base64-salt$base64-derived-key

# Required — Shared password gating the entire site (distribute via internal chat)
SITE_ACCESS_PASSWORD_HASH=scrypt$v1$base64-salt$base64-derived-key

# Optional — App identifier used for cookie naming (default: svp)
VITE_APP_ID=svp

# Set automatically by Railway — do not set manually
# PORT=3000
# NODE_ENV=production
